{
  "openapi": "3.1.0",
  "info": {
    "title": "trust-deeds",
    "description": "",
    "version": "0.1.0"
  },
  "paths": {
    "/integrations/{slug}/sync/run": {
      "post": {
        "tags": [
          "integration-sync"
        ],
        "operationId": "runIntegrationSync",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sync completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncExecutionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Sync is already running or configuration is incomplete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncConflictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Synchronization is not supported for this integration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The provider sync failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncExecutionResponse"
                }
              }
            }
          },
          "503": {
            "description": "Synchronization is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/integrations/{slug}/sync/status": {
      "get": {
        "tags": [
          "integration-sync"
        ],
        "operationId": "getIntegrationSyncStatus",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current or most recent sync execution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Synchronization is not supported for this integration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Sync status is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SyncConflictResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SyncExecutionResponse"
          },
          {
            "$ref": "#/components/schemas/SyncErrorResponse"
          }
        ]
      },
      "SyncErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SyncExecutionResponse": {
        "type": "object",
        "required": [
          "outcome",
          "run"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "run": {
            "$ref": "#/components/schemas/SyncRun"
          }
        }
      },
      "SyncRun": {
        "type": "object",
        "required": [
          "id",
          "connection_slug",
          "started_at",
          "status",
          "events_upserted",
          "loans_upserted",
          "snapshots_created"
        ],
        "properties": {
          "connection_slug": {
            "type": "string"
          },
          "endpoints_hit": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "events_upserted": {
            "type": "integer",
            "format": "int64"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "loans_upserted": {
            "type": "integer",
            "format": "int64"
          },
          "scheduled_for": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshots_created": {
            "type": "integer",
            "format": "int64"
          },
          "started_at": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SyncRunStatus"
          }
        }
      },
      "SyncRunStatus": {
        "type": "string",
        "enum": [
          "running",
          "success",
          "error"
        ]
      },
      "SyncStatusResponse": {
        "type": "object",
        "properties": {
          "run": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncRun"
              }
            ]
          }
        }
      }
    }
  }
}