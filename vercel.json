{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "installCommand": "cd client && npm ci --no-audit --no-fund",
  "buildCommand": "cd client && npm run build && cd .. && cargo build --release --locked --no-default-features --features remote-db --bin index",
  "functions": {
    "api/index.rs": {
      "runtime": "vercel-rust@4.0.11",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/internal/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/timing-probe.txt",
      "headers": [
        {
          "key": "Server-Timing",
          "value": "edge-probe;dur=1.0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/static/favicon.ico"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
