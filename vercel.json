{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client && npm run build && cd .. && cargo build --release --locked --no-default-features --features remote-db --bin index",
  "crons": [
    {
      "path": "/internal/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/index.rs": {
      "maxDuration": 300,
      "runtime": "vercel-rust@4.0.11"
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/dist/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ],
      "source": "/static/(.*)"
    },
    {
      "headers": [
        {
          "key": "Server-Timing",
          "value": "edge-probe;dur=1.0"
        }
      ],
      "source": "/static/timing-probe.txt"
    }
  ],
  "installCommand": "cd client && npm ci --no-audit --no-fund",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "destination": "/static/favicon.ico",
      "source": "/favicon.ico"
    },
    {
      "destination": "/api/index",
      "source": "/(.*)"
    }
  ]
}
